{
  "name": "vocab-rabbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:github",
    "build:github": "tsc --noEmit && vite build --mode github-pages",
    "build:esa": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "npm run build && node scripts/preview-github-pages.mjs",
    "deploy:github:legacy": "node scripts/deploy-gh-pages.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.9"
  }
}
