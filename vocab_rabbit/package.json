{
  "name": "vocab-rabbit",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:esa",
    "build:github": "tsc --noEmit && vite build --mode github-pages",
    "build:esa": "tsc --noEmit && vite build --mode esa && node scripts/build-word-atlases.mjs dist",
    "generate:review-preview-scales": "node scripts/generate-review-preview-scales.mjs",
    "test": "vitest run --exclude e2e/**",
    "test:interactions": "playwright test",
    "preview": "npm run build:github && node scripts/preview-github-pages.mjs",
    "deploy:github:legacy": "node scripts/deploy-gh-pages.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.9"
  }
}
